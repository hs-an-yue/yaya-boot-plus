<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yaya.system.mapper.SysSecretKeyMapper">

    <!--
        自定义 SQL 统一写在本文件(接口中不允许写注解 SQL)
        继承 BaseMapper 提供的通用方法无需在此声明
    -->

    <update id="logicDeleteById">
        UPDATE sys_secret_key
        SET is_deleted = 1,
            update_by = #{updateBy},
            update_time = #{updateTime}
        WHERE key_id = #{keyId}
          AND is_deleted = 0
    </update>
    <select id="selectSecretKeyPage" resultType="com.yaya.system.domain.entity.SysSecretKey">
        SELECT * FROM sys_secret_key sk ${ew.customSqlSegment}
    </select>

</mapper>
